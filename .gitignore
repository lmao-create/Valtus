# --- Generated release artifacts (never commit ISOs) ------------------------
releases/*.iso
releases/*.iso.sha256
releases/*.manifest.txt
releases/*.build.log
releases/known-good/

# --- VM disks and QEMU state ------------------------------------------------
*.qcow2
*.raw
*.img
*.vhdx

# --- Local overrides for sensitive values (env-file pattern) ----------------
config/valtus.local.env

# --- Build/test artifacts ----------------------------------------------------
logs/*.log
logs/*.manifest.txt
logs/*.ppm
logs/*.png
logs/*.serial
logs/vm-test-*/
logs/os-release.built.txt
logs/lsb-release.built.txt
build/
.valtus-vm-test-*/

# --- Antivirus build outputs (built by scripts/build-valtus-security.sh) ----
# The debs and staging trees are generated; the source project lives outside
# this repository. Keep the build script and docs, never the artifacts.
*.deb
av-build/

# --- Scratch rootfs copies used by dev verification scripts -----------------
# (e.g. /root/valtus-av-test, /root/valtus-av-clean inside WSL; the rules are
# here in case such directories are ever created inside the workspace)
valtus-av-*/

# --- Python / editor noise ---------------------------------------------------
__pycache__/
*.pyc
.pytest_cache/
Thumbs.db
Desktop.ini
~$*
*.tmp

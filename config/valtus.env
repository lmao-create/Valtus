# =============================================================================
# Valtus — credentials & sensitive defaults (env-file pattern)
# =============================================================================
# All passwords and sensitive defaults for the Valtus build live HERE, in one
# env-style file, and are sourced by the build/test scripts. No script may
# contain an inline password.
#
# WARNING / THREAT MODEL
#   These are the FIXED, DOCUMENTED default credentials of the Valtus LIVE
#   session (like a demo account). They are intentionally deterministic so
#   builds are reproducible and testers can log in.
#   - The live session has NO network services listening (no sshd, ufw
#     default-deny incoming) and the root account is locked, so this password
#     is local-console-only attack surface.
#   - Do NOT put personal secrets, API keys or private keys in this file.
#     For machine-specific or private values use:
#         config/valtus.local.env   (gitignored, overrides this file)
#   - Installed systems created via the installer ask the user for their own
#     password and must not reuse these values.
#
# Format: POSIX shell key="value" (sourced with . file). No spaces in values.
# =============================================================================

# --- Live session default user ----------------------------------------------
# Username created by casper for the live session (also in /etc/casper.conf).
LIVE_USER="valtus"
# Display name for the live user.
LIVE_USER_FULLNAME="Valtus Live User"
# Fixed live-session password (documented in README/INSTALLATION).
LIVE_USER_PASSWORD="valtus"
# Autologin: disabled on purpose (security-first). The SDDM login screen is
# shown; the credentials above are used to log in.
LIVE_AUTOLOGIN="0"

# --- Placeholders for future optional secrets (leave empty unless needed) ---
# Example: ISO signing key passphrase used by release tooling (empty = none).
ISO_SIGNING_KEY_ID=""

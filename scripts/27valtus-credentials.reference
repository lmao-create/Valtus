#!/bin/sh
# Generated by Valtus build.sh from config/valtus.env — DO NOT edit by hand.
# Runs in the casper (initramfs) phase AFTER casper's own 15autologin and
# 25adduser scripts (casper 1.498, noble). See docs/ARCHITECTURE.md.
PREREQ="25adduser 15autologin"
prereqs() { echo "$PREREQ"; }
. /scripts/casper-functions 2>/dev/null || true

. /etc/casper.conf 2>/dev/null || true
: ${USERNAME:=valtus}

case "$1" in
prereqs) prereqs; exit 0 ;;
esac

log_begin_msg "valtus: provisioning live session credentials" 2>/dev/null || \
  echo "valtus: credentials" > /dev/kmsg

# 1) Fixed, documented live-session password (from config/valtus.env).
#    With sddm installed, casper leaves an empty password for the live user;
#    this chpasswd makes the documented credential the real one.
if id "$USERNAME" >/dev/null 2>&1; then
  echo "valtus:valtus" | chpasswd 2>/dev/null || \
    echo "valtus: chpasswd failed" > /dev/kmsg
fi

# 2) Security: remove casper's passwordless sudo grant; the live user is in
#    the sudo group and must authenticate for privilege escalation.
rm -f /etc/sudoers.d/casper 2>/dev/null || true

# 3) Security: no autologin. Casper appends an [Autologin] section to
#    /etc/sddm.conf; override the keys via an alphanumerically-last conf.d
#    fragment (SDDM merges /etc/sddm.conf.d/* after /etc/sddm.conf).
cat > /etc/sddm.conf.d/zz-valtus-no-autologin.conf <<'EOF'
[Autologin]
User=
Session=
EOF
# Belt and braces: strip any [Autologin] block from /etc/sddm.conf itself.
if [ -f /etc/sddm.conf ]; then
  awk '/^\[Autologin\]/ { s = 1 }
       s && /^\[/ && !/^\[Autologin\]/ { s = 0 }
       !s || (/^\[/ && !/^\[Autologin\]/)' /etc/sddm.conf > /etc/sddm.conf.new 2>/dev/null
  [ -s /etc/sddm.conf.new ] && mv /etc/sddm.conf.new /etc/sddm.conf 2>/dev/null || rm -f /etc/sddm.conf.new 2>/dev/null
fi

log_end_msg 2>/dev/null || true
exit 0
